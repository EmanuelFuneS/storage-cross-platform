{
  "name": "cdk-app",
  "version": "0.1.0",
  "bin": {
    "cdk-app": "bin/cdk-app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:dev": "cdk deploy storage-dev-network storage-dev-bucket --context environment=dev --require-approval never",
    "destroy:dev": "cdk destroy --all --context environment=dev",
    "destroy:prod": "cdk destroy --all --context environment=prod"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.0",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1033.0",
    "@aws-sdk/client-s3": "^3.1033.0",
    "@aws-sdk/s3-request-presigner": "^3.1033.0",
    "aws-cdk": "^2.1112.0",
    "aws-cdk-lib": "^2.242.0",
    "constructs": "^10.5.0"
  }
}
