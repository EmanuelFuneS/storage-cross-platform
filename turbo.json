{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",

    "DB_HOST",
    "DB_PORT",
    "DB_USER",
    "DB_PASSWORD",
    "DB_NAME",

    "DATABASE_URL",
    "DIRECT_URL",

    "NEON_DATABASE_URL",

    "PGHOST",
    "PGDATABASE",
    "PGUSER",
    "PGPASSWORD",
    "PGSSLMODE",
    "PGCHANNELBINDING",

    "NEXT_PUBLIC_APP",
    "AUTH_SECRET",

    "NEXT_PUBLIC_CLOUDFRONT_DOMAIN",
    "PRESIGNED_LAMBDA_URL"
  ],
  "tasks": {
    "build": {
      "env": [],
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "env": [
        "NODE_ENV",

        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",

        "DATABASE_URL",
        "DIRECT_URL",

        "NEON_DATABASE_URL",

        "PGHOST",
        "PGDATABASE",
        "PGUSER",
        "PGPASSWORD",
        "PGSSLMODE",
        "PGCHANNELBINDING",

        "NEXT_PUBLIC_APP",
        "AUTH_SECRET",

        "NEXT_PUBLIC_CLOUDFRONT_DOMAIN",
        "PRESIGNED_LAMBDA_URL"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
